# Git LFS for Unreal binary assets (some exceed GitHub's 100 MB per-file limit).
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text
*.upack  filter=lfs diff=lfs merge=lfs -text
*.mhpkg  filter=lfs diff=lfs merge=lfs -text

# Normalize text line endings for source
*.cpp   text
*.h     text
*.cs    text
*.ps1   text
*.md    text
# Generated score: a real waveform, not a text asset. Without this, git mangles CRLF in it.
Deployment/audio/*.wav binary

# Shell scripts run on Linux (core-2, and inside the dev-5.5 container). A CRLF checkout on
# Windows makes bash fail with "$'': command not found" and "set: pipefail: invalid option
# name" -- errors that name the shell, not the line endings that caused them.
*.sh    text eol=lf
