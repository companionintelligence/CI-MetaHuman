# Unreal Engine generated / build output
Binaries/
Intermediate/
DerivedDataCache/
Saved/
*.tmp

# IDE / project files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# OS cruft
Thumbs.db
.DS_Store

# Local secrets — never commit real OIDC/hub credentials
Deployment/.env
# Listed separately rather than as Deployment/.env* -- the two .example templates beside these
# are tracked on purpose, and a glob here would be one rename away from ignoring them too.
# .env.edge holds the OIDC client secret and cookie secret, so it must never be committable.
Deployment/.env.edge
*.local.env

# Native build output (BuildNative.ps1 / RunUAT BuildCookRun)
/Build/
/dist/
/Samples/

# Authored at build time by Deployment/author_diorama.py — generated content, not source.
# Scripts/BuildNative.ps1 stages Nia here (only with -Resident Nia) and re-imports the props on every build, exactly as
# the container cook does. The set is DEFINED by that script; these are its output, and
# committing them would be committing a build artifact of one engine version.
/Content/CC_ControlRig_Nia/
/Content/Diorama/
/Content/Seo/
/Content/Audio/
# The authoring run's result, written beside the map it vouches for (the image builds' CHECK_MAP and
# BuildNative.ps1 -SkipAuthoring read it there).
/Content/AUTHOR_RESULT.txt
Content/Maps/CompanionStage.umap.orig
MetaHumanLocalLLM.uproject.orig

# Python bytecode from running the authoring scripts locally
__pycache__/
*.pyc

# Wrangler local credentials metadata and emulator state.
**/.wrangler/

# Measurements, not source. Scripts/RunConversationE2E.py writes this into the working directory on
# every run; the numbers belong in whatever doc quotes them, not in the tree.
conversation_e2e_results.json

# Audit capture output: reproducible, ~40 MB of PNG/GIF. The report .md is what matters.
Docs/audit-*/media/

# The resident Eliza (Deployment/author_diorama.py, MHLLM_RESIDENT=eliza). Her content is STAGED here by
# Scripts/BuildNative.ps1 -Resident Eliza (or copied in by the core-2 authoring run) from private storage,
# never committed: /Content/Eliza/ is the built variant, /Content/EditableCharacters/ the MetaHuman source.
/Content/Eliza/
/Content/EditableCharacters/
