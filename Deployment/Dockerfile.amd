# syntax=docker/dockerfile:1
#
# AMD Pixel Streaming image — parameterized by engine version. Build a 5.5 OR a 5.8 container
# from ONE file:
#
#   docker build -f Deployment/Dockerfile.amd -t ci/metahuman-local-llm:5.8 ..                     # 5.8 (default)
#   docker build -f Deployment/Dockerfile.amd --build-arg RELEASE=5.5 -t ci/metahuman-local-llm:5.5 ..
#
# Nothing else needs to change between versions: Target.cs uses BuildSettingsVersion.Latest, and
# MetaHumanLocalLLM.uproject marks the 5.8-only plugins (Unreal-MCP, MetaHuman*) "Optional" so the
# same project opens in the 5.8 dev editor yet cooks clean on 5.5. For pre-5.6 targets, the build
# drops 5.8-only plugins and MetaHumanCharacter assets, and synthesizes a stage ONLY if none was
# supplied.
#
# The plugin strip-list below is a safety net, not redundancy: the 5.8 editor ADDS plugins to the
# .uproject on its own (this is how AIAssistant appeared), and it adds them as REQUIRED rather than
# "Optional": true, so a 5.5 cook hard-fails with "Unable to find plugin". Anything 5.8-only that
# shows up must be listed here or the next cook from a full checkout breaks.
#
# Stage 1 packages on Epic's dev image; stage 2 is an Ubuntu+Mesa (RADV/VAAPI) runtime so the app
# renders with Vulkan and hardware-encodes over /dev/dri. Prereq: ghcr.io/epicgames access.

ARG RELEASE=5.8
FROM ghcr.io/epicgames/unreal-engine:dev-${RELEASE} AS builder
ARG RELEASE

COPY --chown=ue4:ue4 . /home/ue4/project-src

USER ue4
RUN cd /home/ue4/project-src \
 && rm -rf Intermediate Saved Binaries DerivedDataCache \
 && python3 -c "import json; p=json.load(open('MetaHumanLocalLLM.uproject')); p['EngineAssociation']='${RELEASE}'; json.dump(p, open('MetaHumanLocalLLM.uproject','w'), indent='\t')" \
 && MINOR="$(echo "${RELEASE}" | cut -d. -f2)" \
 && if [ "${MINOR:-8}" -lt 6 ]; then \
        python3 -c "import json; path='MetaHumanLocalLLM.uproject'; p=json.load(open(path)); disabled={'MCPClientToolset','ModelContextProtocol','AllToolsets','MetaHuman','MetaHumanCharacter','MetaHumanCalibrationProcessing','MetaHumanCoreTech','MetaHumanLiveLink','MetaHumanGenerator','MetaHumanCharacterUAF','MetaHumanCalibrationDiagnostics','AIAssistant'}; p['Plugins']=[plugin for plugin in p.get('Plugins', []) if plugin.get('Name') not in disabled]; json.dump(p, open(path,'w'), indent='\t')"; \
        echo "RELEASE ${RELEASE} < 5.6: dropping 5.8-only MetaHumanCharacter assets"; \
        rm -rf Content/MetaHumans Content/KhaosMDF492 Content/TestMetaHumanCharacter.uasset \
               Content/OA_KhaosMDF492.uasset Content/WI_KhaosMDF492.uasset; \
        if [ -f Content/Maps/CompanionStage.umap ]; then \
            echo "Using the SUPPLIED CompanionStage.umap (authored upstream); not regenerating."; \
        else \
            echo "No CompanionStage.umap supplied; synthesizing a minimal stage."; \
            mkdir -p /tmp/stage-authoring/Content Content/Maps; \
            python3 -c "import json; p={'FileVersion':3,'EngineAssociation':'${RELEASE}','Plugins':[{'Name':'MoverTests','Enabled':True},{'Name':'PythonScriptPlugin','Enabled':True}]}; json.dump(p, open('/tmp/stage-authoring/StageAuthoring.uproject','w'), indent='\t')"; \
            /home/ue4/UnrealEngine/Engine/Binaries/Linux/UnrealEditor-Cmd /tmp/stage-authoring/StageAuthoring.uproject -run=pythonscript -script=/home/ue4/project-src/Deployment/author_companion_stage.py -unattended -nop4 -nosplash -nullrhi; \
            cp /tmp/stage-authoring/Content/Maps/CompanionStage.umap Content/Maps/CompanionStage.umap; \
            rm -rf /tmp/stage-authoring; \
        fi; \
        test -f Content/Maps/CompanionStage.umap; \
    fi

RUN /home/ue4/UnrealEngine/Engine/Build/BatchFiles/RunUAT.sh BuildCookRun \
    -project=/home/ue4/project-src/MetaHumanLocalLLM.uproject \
    -clientconfig=Development -utf8output -nodebuginfo -map=/Game/Maps/CompanionStage -noP4 \
    -cook -build -stage -prereqs -pak -archive \
    -archivedirectory=/home/ue4/project-src/dist \
    -platform=Linux

# ---- AMD runtime image ----
# Ubuntu 26.04 matches the host's Mesa 26.x (needed for the Strix Halo / RDNA 3.5 GPU; older
# Mesa yields VK_ERROR_INCOMPATIBLE_DRIVER). /dev/dri is passed in at runtime by the compose.
FROM ubuntu:26.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers mesa-va-drivers libvulkan1 vulkan-tools vainfo \
        libva2 libva-drm2 libgl1 libglu1-mesa \
        libsm6 libxext6 libxrender1 libxi6 libxkbcommon0 \
        libasound2t64 libpulse0 libssl3 ca-certificates libnss3 libatk1.0-0 libcups2 \
    && rm -rf /var/lib/apt/lists/*

# Packaged UE Linux binaries refuse to run as root; use a non-root user at uid 1001 (ubuntu:26.04
# already owns 1000). /dev/dri access comes from the container's group_add in docker-compose.amd.yml.
# A null ALSA default so UE's audio mixer can START in a container with no sound hardware.
# Without it the mixer only ever reaches "Pre-Initialized", Pixel Streaming has no submix to
# capture, and the negotiated audio track carries digital silence forever -- a failure that looks
# identical to working audio unless you measure the track's energy.
RUN { echo "pcm.!default { type null }"; echo "ctl.!default { type null }"; } > /etc/asound.conf

RUN useradd -m -u 1001 -s /bin/bash ue4
COPY --from=builder --chown=ue4:ue4 /home/ue4/project-src/dist/Linux /home/ue4/project
USER ue4
ENV LIBVA_DRIVER_NAME=radeonsi
ENTRYPOINT ["/home/ue4/project/MetaHumanLocalLLM.sh"]
