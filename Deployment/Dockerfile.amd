# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# AMD Pixel Streaming image — parameterized by engine version. ONE file builds either engine:
#
#   docker build -f Deployment/Dockerfile.amd -t ci/metahuman-local-llm:5.8 .                       # 5.8 (default)
#   docker build -f Deployment/Dockerfile.amd --build-arg RELEASE=5.5 -t ci/metahuman-local-llm:5.5 .
#
# 5.8 IS THE NORMAL TARGET, because it is the only one that can cook this project. Every
# git-tracked package under Content/ is UE5 package version 1018 and UE 5.5.4 reads at most 1013;
# package serialisation is forward-only, so a 5.5 cook fails at LOAD rather than at compile --
# which is exactly why a compile-only check kept reporting that 5.5 was fine. The full reasoning is
# in Scripts/BuildNative.ps1's -Engine notes; keep to that account rather than starting a parallel one.
#
# The 5.5 path below is deliberately kept working: the C++ does still compile on 5.5, and
# Scripts/RunCompatMatrix.ps1 builds and tests the plugin against both engines to keep it that way.
# RELEASE stays a build-arg. 5.5 is the version you ask for on purpose, not the one you get.
#
# Little else changes between versions: Target.cs uses BuildSettingsVersion.Latest, and
# MetaHumanLocalLLM.uproject marks the 5.8-only plugins (Unreal-MCP, MetaHuman*) "Optional" so the
# same project opens in the 5.8 dev editor and still configures for a pre-5.6 build. For pre-5.6
# targets, the build drops 5.8-only plugins and MetaHumanCharacter assets, and synthesizes a stage
# ONLY if none was supplied.
#
# The plugin strip-list below is a safety net, not redundancy: the 5.8 editor ADDS plugins to the
# .uproject on its own (this is how AIAssistant appeared), and it adds them as REQUIRED rather than
# "Optional": true, so a 5.5 cook hard-fails with "Unable to find plugin". Anything 5.8-only that
# shows up must be listed here or the next cook from a full checkout breaks.
#
# AND THE TYPE STILL HAS TO RESOLVE. Stripping the DefaultGame.ini rule was not sufficient alone:
# the strip demonstrably runs ("stripped the GameFeatureData asset-manager rule") and the cook STILL
# ended on `Ensure condition failed: AssetBaseClassLoaded ... Failed to load class
# /Script/GameFeatures.GameFeatureData for Primary Asset Type GameFeatureData` -- with that rule the
# only declaration anywhere in the tree. So GameFeatures is now ENABLED for pre-5.6 cooks rather
# than reasoned about: it is an engine plugin present in 5.5, and giving the type its class cures
# the error the log actually names, whichever config layer asks for the scan.
#
# This failure looks the opposite of what it is: `LogCook: Display: Done!` appears FIRST -- every
# package cooked -- and the ensure fires afterwards at engine init, inside the end-of-run
# "Warning/Error Summary". The commandlet exits 1 on the error COUNT, and UAT reports
# Error_UnknownCookFailure(25). A successful cook that still fails the build.
#
# GameFeatures is enabled EXPLICITLY below, and that line is load-bearing. DefaultGame.ini carries an
# asset-manager rule for GameFeatureData whose AssetBaseClass is /Script/GameFeatures.GameFeatureData.
# Stripping the 5.8 plugins leaves GameFeatures to arrive late, as somebody else's dependency, which
# puts it on the wrong side of UAssetManager::ScanPrimaryAssetTypesFromConfig at engine init. Both
# ways of being wrong here fail the cook, and they look nothing alike:
#
#   rule present, class not yet loadable -> AssetBaseClassLoaded ensure, ~20 Error lines, 23 errors
#   rule removed, GameFeatures then loads -> LogGameFeatures "no rule for GameFeatureData", 2 errors
#
# In BOTH cases every package cooks and "Finalisation: End / Done!" is reached; the commandlet exits
# 1 purely on the logged error COUNT, and UAT relabels that as Error_UnknownCookFailure(25). So the
# cure is neither to keep nor to drop the rule but to make the class resolvable BEFORE the scan --
# which is what enabling the plugin as a project plugin does. Removing this line resurrects one of
# the two failures above depending on which way you then edit the .ini, so do not "simplify" it.
#
# Stage 1 packages on Epic's dev image; stage 2 is an Ubuntu+Mesa (RADV/VAAPI) runtime so the app
# renders with Vulkan and hardware-encodes over /dev/dri. Prereq: ghcr.io/epicgames access, and the
# AUTHORED set in Content/ -- the build refuses to cook the committed 23 KB stub map (CHECK_MAP).
#
# BASE IMAGES ARE PINNED BY DIGEST (tag kept beside each for the reader). RELEASE selects one of
# the digest-pinned engine stages below instead of the floating dev-<release> tag; BuildKit pulls
# only the stage it names. The engine digests are shared with Dockerfile, Dockerfile.editorpreview
# and core2/pin-engine-image.sh -- move them together (CI checks that they agree). See
# Docs/BUILD-AND-DEPLOY.md section 7.

ARG RELEASE=5.8
FROM ghcr.io/epicgames/unreal-engine:dev-5.8.4@sha256:675755b3b06fc3bf450a1eafe52a75f0d043e8b060932a3e1e703f6cf91b7810 AS engine-5.8
FROM ghcr.io/epicgames/unreal-engine:dev-5.5.4@sha256:3f7b292cda7f6066aeaea46fa95a520a0d26811810e0d082cfbf5dc85018bd82 AS engine-5.5

FROM engine-${RELEASE} AS builder
ARG RELEASE

COPY --chown=ue4:ue4 . /home/ue4/project-src

USER ue4
RUN cd /home/ue4/project-src \
 && rm -rf Intermediate Saved Binaries DerivedDataCache \
 && python3 -c "import json; p=json.load(open('MetaHumanLocalLLM.uproject')); p['EngineAssociation']='${RELEASE}'; json.dump(p, open('MetaHumanLocalLLM.uproject','w'), indent='\t')" \
 && MINOR="$(echo "${RELEASE}" | cut -d. -f2)" \
 && if [ "${MINOR:-8}" -lt 6 ]; then \
        python3 -c "import json; path='MetaHumanLocalLLM.uproject'; p=json.load(open(path)); disabled={'MCPClientToolset','ModelContextProtocol','AllToolsets','MetaHuman','MetaHumanCharacter','MetaHumanCalibrationProcessing','MetaHumanCoreTech','MetaHumanLiveLink','MetaHumanGenerator','MetaHumanCharacterUAF','MetaHumanCalibrationDiagnostics','AIAssistant'}; p['Plugins']=[plugin for plugin in p.get('Plugins', []) if plugin.get('Name') not in disabled]; p['Plugins'].append({'Name':'GameFeatures','Enabled':True}); json.dump(p, open(path,'w'), indent='\t')"; \
        python3 -c "import json; path='MetaHumanLocalLLM.uproject'; p=json.load(open(path)); names={x.get('Name') for x in p.get('Plugins', [])}; p['Plugins'].append({'Name':'GameFeatures','Enabled':True}) if 'GameFeatures' not in names else None; json.dump(p, open(path,'w'), indent='\t'); print('GameFeatures enabled explicitly for the 5.5 cook')"; \
        echo "RELEASE ${RELEASE} < 5.6: dropping 5.8-only MetaHumanCharacter assets"; \
        rm -rf Content/MetaHumans Content/KhaosMDF492 Content/TestMetaHumanCharacter.uasset \
               Content/OA_KhaosMDF492.uasset Content/WI_KhaosMDF492.uasset; \
        if [ -f Content/Maps/CompanionStage.umap ]; then \
            echo "Using the SUPPLIED CompanionStage.umap (authored upstream); not regenerating."; \
        else \
            echo "No CompanionStage.umap supplied; synthesizing a minimal stage."; \
            mkdir -p /tmp/stage-authoring/Content Content/Maps; \
            python3 -c "import json; p={'FileVersion':3,'EngineAssociation':'${RELEASE}','Plugins':[{'Name':'MoverTests','Enabled':True},{'Name':'PythonScriptPlugin','Enabled':True}]}; json.dump(p, open('/tmp/stage-authoring/StageAuthoring.uproject','w'), indent='\t')"; \
            /home/ue4/UnrealEngine/Engine/Binaries/Linux/UnrealEditor-Cmd /tmp/stage-authoring/StageAuthoring.uproject -run=pythonscript -script=/home/ue4/project-src/Deployment/author_companion_stage.py -unattended -nop4 -nosplash -nullrhi; \
            cp /tmp/stage-authoring/Content/Maps/CompanionStage.umap Content/Maps/CompanionStage.umap; \
            rm -rf /tmp/stage-authoring; \
            touch /tmp/CompanionStage.synthesized; \
        fi; \
        test -f Content/Maps/CompanionStage.umap; \
    fi

# ---- Refuse to cook the stub map -----------------------------------------------------------
# The same gate as Dockerfile, byte-for-byte (CI runs this script against fixtures and fails if
# the two copies differ). On core-2, m2_clean.sh copies the authored Content/ in before building,
# so this passes; what it stops is a build from a clean checkout, whose CompanionStage.umap is
# the 23 KB stub committed to git. A pre-5.6 build whose context has NO map still gets the
# minimal synthesized stage above -- that branch leaves /tmp/CompanionStage.synthesized, and the
# gate lets it through with a warning. See Docs/BUILD-AND-DEPLOY.md section 2.2.
ARG ALLOW_STUB_MAP=0
WORKDIR /home/ue4/project-src
RUN <<'CHECK_MAP'
set -eu
map=Content/Maps/CompanionStage.umap
stub_sha256=688fb6b8f0f6528404e9088ba389fd876c344044c947a28395ab0aac64b6fc10
min_bytes=204800
if [ -f /tmp/CompanionStage.synthesized ]; then
    echo "CHECK_MAP: WARNING: $map is the minimal fallback stage this build synthesized for a"
    echo "CHECK_MAP: pre-5.6 engine (no set, no resident). Cooking it because the context supplied no map."
    exit 0
fi
problem=""
if [ ! -f "$map" ]; then
    problem="is missing"
elif head -c 100 "$map" | grep -q '^version https://git-lfs'; then
    problem="is a Git LFS pointer, not a map (the checkout was made without git-lfs)"
elif [ "$(sha256sum "$map" | cut -d ' ' -f 1)" = "$stub_sha256" ]; then
    problem="is the 23 KB stub committed to git (sky and ground: no set, no resident)"
elif [ "$(wc -c < "$map")" -lt "$min_bytes" ]; then
    problem="is only $(wc -c < "$map") bytes, which is a stub rather than the authored set"
fi
if [ -z "$problem" ]; then
    echo "CHECK_MAP: OK, $map is $(wc -c < "$map") bytes"
    exit 0
fi
if [ "${ALLOW_STUB_MAP:-0}" = "1" ]; then
    echo "CHECK_MAP: WARNING: $map $problem."
    echo "CHECK_MAP: ALLOW_STUB_MAP=1, so cooking it anyway. This image opens onto an EMPTY STAGE; never ship it."
    exit 0
fi
echo "CHECK_MAP: REFUSING TO COOK: $map $problem." >&2
echo "CHECK_MAP: This Dockerfile does not author the set. Author it, put the authored Content/ in the" >&2
echo "CHECK_MAP: build context, and rebuild: Docs/BUILD-AND-DEPLOY.md section 2.2. (Dockerfile.amd with" >&2
echo "CHECK_MAP: RELEASE < 5.6 instead synthesizes a minimal fallback stage when the context has NO map.)" >&2
echo "CHECK_MAP: --build-arg ALLOW_STUB_MAP=1 builds anyway, for a toolchain smoke test only." >&2
exit 1
CHECK_MAP

# ---- RADV workarounds, baked into the image's config ---------------------------------------
# docker-compose.amd.yml used to pass these as -ExecCmds. This image is now a Shipping build (see
# the cook below), and Shipping compiles out every command-line route to a cvar (-ExecCmds, -ini:
# and -dpcvars), so they would have been dropped without a word. They go into the project's Linux
# engine config instead: [SystemSettings] is read at startup by every build configuration, and only
# this AMD image writes the file, so the NVIDIA image keeps the engine defaults. Two differences
# from -ExecCmds, both in the direction the list intends: the values hold from the first frame
# rather than after it (so read-only cvars such as r.RayTracing now apply too), and the cook sees
# them as well. -noraytracing stays on the compose command line; Shipping honours it.
# Not yet measured on the Strix Halo host: verify the stream there before relying on it.
RUN mkdir -p Config/Linux \
 && printf '%s\n' '' \
        '; Written by Deployment/Dockerfile.amd: the RADV workarounds from docker-compose.amd.yml.' \
        '[SystemSettings]' \
        'r.RayTracing=0' \
        'r.Lumen.HardwareRayTracing=0' \
        'r.DynamicGlobalIlluminationMethod=0' \
        'r.ReflectionMethod=0' \
        'r.SkyLight.RealTimeReflectionCapture=0' \
        'r.SkyAtmosphere=0' \
        'r.ReflectionCaptureResolution=0' \
        'r.Vulkan.WaitForIdleOnSubmit=2' \
        'r.GenerateMeshDistanceFields=0' \
        'r.Nanite=0' \
    >> Config/Linux/LinuxEngine.ini \
 && cat Config/Linux/LinuxEngine.ini

# Shipping, like Dockerfile: no console, cheat or stat commands, no command-line overrides, and no
# engine log on stdout (Dockerfile's cook step says why an installed engine cannot add it back).
RUN /home/ue4/UnrealEngine/Engine/Build/BatchFiles/RunUAT.sh BuildCookRun \
    -project=/home/ue4/project-src/MetaHumanLocalLLM.uproject \
    -clientconfig=Shipping -utf8output -nodebuginfo -map=/Game/Maps/CompanionStage -noP4 \
    -cook -build -stage -prereqs -pak -archive \
    -archivedirectory=/home/ue4/project-src/dist \
    -platform=Linux

# The licence and attributions travel with the package, as in Dockerfile (whose comment says why):
# MetaHumanLocalLLM.Build.cs stages them, and this refuses an image that came out without them.
RUN for f in LICENSE NOTICE.md CREDITS.md; do \
        test -s "dist/Linux/MetaHumanLocalLLM/$f" || { \
            echo "The package has no MetaHumanLocalLLM/$f, so it would ship without its licence and attributions." >&2; \
            exit 1; }; \
    done

# ---- AMD runtime image ----
# Ubuntu 26.04 matches the host's Mesa 26.x (needed for the Strix Halo / RDNA 3.5 GPU; older
# Mesa yields VK_ERROR_INCOMPATIBLE_DRIVER). /dev/dri is passed in at runtime by the compose.
FROM ubuntu:26.04@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers mesa-va-drivers libvulkan1 vulkan-tools vainfo \
        libva2 libva-drm2 libegl1 libgl1 libglu1-mesa \
        libsm6 libxext6 libxrender1 libxi6 libxkbcommon0 \
        libasound2t64 libpulse0 libssl3 ca-certificates libnss3 libatk1.0-0 libcups2 \
    && rm -rf /var/lib/apt/lists/*

# Packaged UE Linux binaries refuse to run as root; use a non-root user at uid 1001 (ubuntu:26.04
# already owns 1000). /dev/dri access comes from the container's group_add in docker-compose.amd.yml.
# A null ALSA default so UE's audio mixer can START in a container with no sound hardware.
# Without it the mixer only ever reaches "Pre-Initialized", Pixel Streaming has no submix to
# capture, and the negotiated audio track carries digital silence forever -- a failure that looks
# identical to working audio unless you measure the track's energy.
RUN { echo "pcm.!default { type null }"; echo "ctl.!default { type null }"; } > /etc/asound.conf

RUN useradd -m -u 1001 -s /bin/bash ue4
COPY --from=builder --chown=ue4:ue4 /home/ue4/project-src/dist/Linux /home/ue4/project
USER ue4
ENV LIBVA_DRIVER_NAME=radeonsi
ENTRYPOINT ["/home/ue4/project/MetaHumanLocalLLM.sh"]
