# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
# There are TWO files to copy now, not one:
#
#     cp .env.example      .env        # this file: app settings + what compose interpolates
#     cp .env.edge.example .env.edge   # oauth2-proxy secrets, read by the oidc-proxy service only
#
# Neither is required for the stack to render — both env_file entries are `required: false` — and
# .env.edge is only needed to run the OIDC login gate.
#
# How these reach the app: docker-compose.yml gives the `project` service `env_file: .env`, so
# every key in this file is handed to the container, with one deliberate exception:
# TURN_STATIC_AUTH_SECRET, which that file blanks for the app (see the TURN section). That is
# newer than this file; before it, a key here only did something if some `environment:` entry in
# a compose file named it by hand, and six app settings named nowhere at all (MHLLM_MAX_TURNS,
# MHLLM_MEMORY, MHLLM_MEMORY_PATH, MHLLM_GAZE, MHLLM_CHAT_TIMEOUT, WHISPER_MODEL) — documented and
# defaulted here, delivered to nothing. Counted against every docker-compose*.yml in this
# directory, not just the three the quickstart uses. UE_RELEASE_SHORT below is a seventh name in
# that state and is left out of the list because it is a different problem: nothing anywhere in
# the repo reads it, so delivering it would not help.
#
# Two consequences worth reading before editing:
#
#  * env_file reads THIS FILE, not your shell. `VAR=x docker compose up` only overrides a key that
#    a compose `environment:` entry also interpolates. docker-compose.yml keeps MHLLM_BACKEND, the
#    CI_HUB_* and OPENAI_* trios, WHISPER_SERVER_URL, PIPER_SERVER_URL and MHLLM_SYSTEM_PROMPT
#    there for exactly that reason; for anything else, edit this file.
#
#  * a value set here also feeds `${VAR:-default}` interpolation in the override compose files, and
#    a non-empty value here therefore BEATS their defaults. That is why OLLAMA_BASE_URL,
#    OLLAMA_MODEL, KOKORO_MODEL and MHLLM_SYSTEM_PROMPT below ship BLANK: each has a per-stack
#    default in docker-compose.face.yml — the :11435 beta-1 tunnel, qwen3.8:27b, kokoro-v1, the
#    Eliza persona — that a value here would silently replace. Blank is safe: `:-` falls back on
#    empty as well as on unset, so blanking RESTORES those defaults rather than voiding them.

# --- Unreal Engine release (matches the ghcr.io image tags) ---
# UE_RELEASE is the builder's dev-<tag> (dev-5.8 is the confirmed floating tag).
UE_RELEASE=5.8
UE_RELEASE_SHORT=5.8

# Built from the pinned Epic Pixel Streaming Infrastructure 5.8 source by docker-compose.yml.
SIGNALLING_IMAGE=ci/pixelstreaming-signalling:ue5.8
PIXEL_STREAMING_INFRASTRUCTURE_REF=289b9542159a6ee6a5d0f62834f1f27a472397b6

# --- PUBLIC_IP: the address peers reach this host on ---
# Wilbur's --public_ip, the host in the STUN and TURN URLs (coturn on :3478), and exempt from
# coturn's private-range peer block (as is every interface address of this host, which coturn reads
# for itself). Left blank, run.sh and the signalling container look it up at api.ipify.org -- a
# request to a third party, and the wrong answer for a tailnet deployment. Pin it to this host's
# tailnet address there (`tailscale ip -4` on the host).
PUBLIC_IP=

# --- WebRTC TURN relay (coturn): time-limited credentials, no account ---
# coturn runs in use-auth-secret mode (the TURN REST API scheme). For every peer that connects,
# the signalling server mints a username carrying its own expiry and a credential that is an HMAC
# of it under this shared secret; coturn recomputes the HMAC. So no browser is ever handed a
# password that outlives TURN_CREDENTIAL_TTL. TURN_USER and TURN_PASSWORD are retired -- that was
# one static account whose password every browser received. Delete them from an older .env.
#
# Generate once: `openssl rand -hex 32`. Letters, digits and + / = . _ ~ - only. Left blank,
# coturn's entrypoint refuses to start and the signalling server offers STUN only -- never an open
# or static relay.
#
# It is a secret the app has no use for, and it stays in this file regardless: docker-compose.yml
# INTERPOLATES it into the turnserver and signalling services' environment, and compose
# interpolation reads this file (or your shell) and never a per-service env_file. Moving it to
# .env.edge would blank it in both places (and giving those services .env.edge would hand them the
# OIDC secrets). It is kept out of the app container the other way instead, by an empty
# `environment:` entry on the `project` service.
TURN_STATIC_AUTH_SECRET=
# Seconds a credential issued to a BROWSER can open a new relay. A session already relaying
# continues past it, and every new connection is issued a fresh pair, so this need not cover a
# whole call. The streamer is configured once, so the server gives it a long-lived pair instead.
TURN_CREDENTIAL_TTL=3600
# TURN over TLS (coturn's 5349 listener). Host paths to a PEM certificate chain and its key -- for
# example the pair `tailscale cert` writes for this host's name. Keep them outside this checkout;
# the key must be readable by the container's nobody:nogroup (uid/gid 65534): chgrp 65534 the key
# and chmod 640 it. Set both or neither; blank runs STUN/TURN on 3478 only. Restart turnserver
# after a renewal.
TURN_TLS_CERT_FILE=
TURN_TLS_KEY_FILE=
# The host:port browsers are told to reach that listener on, advertised as turns:...?transport=tcp.
# It must be the NAME in the certificate (not an IP), port 5349. Blank = not advertised.
TURN_TLS_SERVER=
# The relay may not reach loopback, link-local, private, CGNAT/tailnet or multicast addresses
# (coturn/turnserver.conf). This host's own addresses are exempt automatically: coturn's entrypoint
# reads every interface address but loopback and link-local when it starts, because the
# host-networked streamer's candidates are there -- behind NAT, a private one -- and PUBLIC_IP is
# exempt too. List others here -- comma-separated, each an IP or a first-last range -- only for a
# peer on ANOTHER machine inside those ranges. An address this host gains after coturn starts
# needs a turnserver restart, not an entry here.
TURN_ALLOWED_PEER_IPS=

# --- STUN ---
# Peers use this stack's own coturn for STUN (PUBLIC_IP:3478); nothing is sent to a third party by
# default. EXTERNAL_STUN_SERVER is an OPT-IN addition, comma-separated host:port (for example a
# public STUN server, if viewers sit behind NATs coturn cannot see past). Every peer that queries
# it discloses its public address to that server's operator, so leave it blank on a tailnet.
EXTERNAL_STUN_SERVER=

# --- CI-portal OIDC (the login gate in front of the stream) ---
# The client secret and the cookie secret are NOT here any more: they are in .env.edge.example ->
# .env.edge, spelled OAUTH2_PROXY_CLIENT_SECRET and OAUTH2_PROXY_COOKIE_SECRET, and the oidc-proxy
# service is the only thing that reads that file. Everything in THIS file goes to the app
# container, and those two have no reader there. What is left below is the non-secret half, which
# docker-compose.yml interpolates into that same service's environment.
#
# Register this deployment as an OIDC client in ci-portal; use its issuer/discovery URL.
CI_PORTAL_ISSUER_URL=https://hub.ci.computer
# Existing CI Portal client registration for this deployment.
CI_PORTAL_CLIENT_ID=ci-metahermit
# Tailscale Serve publishes the loopback proxy over HTTPS on port 10000, so this is
# https://<this host's MagicDNS name>:10000/oauth2/callback -- the name ends in .ts.net; see
# `tailscale status` on the host. It must match the redirect URI registered for the client in CI
# Portal exactly. The value below is a placeholder that never resolves (.invalid): replace it. Real
# host names stay out of this file, which is public.
CI_PORTAL_REDIRECT_URL=https://stream-host.example.invalid:10000/oauth2/callback

# --- Who may watch: the sign-in allowlist (deny by default) ---
# A CI Portal sign-in proves who someone is; these three decide who is let in. With all three
# blank, oauth2-proxy refuses EVERY account with a 403 after it signs in -- the gate fails closed.
# docker-compose.yml interpolates them into the oidc-proxy service; oauth2-proxy.cfg explains the
# rules in full.
#
# Host path to a file of allowed addresses, one per line ('#' starts a comment). Keep it OUTSIDE
# this checkout -- it is a list of real people's addresses -- and world-readable (chmod 644), since
# oauth2-proxy runs as an unprivileged user. Restart oidc-proxy after editing it. A path that does
# not exist stops the container rather than starting an open gate.
CI_PORTAL_ALLOWED_EMAILS_FILE=
# Comma-separated domains whose addresses pass, e.g. example.com,example.org.
CI_PORTAL_ALLOWED_EMAIL_DOMAINS=
# Comma-separated group names from the Portal's `groups` ID-token claim. This NARROWS the two
# above rather than adding to them: a user must pass the address check AND be in one of these
# groups. To admit by group alone, set CI_PORTAL_ALLOWED_EMAIL_DOMAINS=* together with this --
# and never set * on its own, which admits every Portal account.
CI_PORTAL_ALLOWED_GROUPS=

# --- CI hub inference (the LLM backend the agent talks to) ---
# The OpenAI-compatible base URL up to and INCLUDING the version segment; UOpenAIChatClient
# appends /chat/completions to it (OpenAIChatClient.cpp, BuildRequestBody).
#
# DO NOT point this at the Hub itself. The Hub does not proxy inference — its own inference
# controller says so ("The Hub does NOT proxy inference requests. Apps talk to the Ollama
# container ... directly"), and this repo's Docs/COMPAT-AND-ECOSYSTEM-REVIEW.md §3 confirmed it by
# enumerating all 190 paths in the Hub's swagger.json: no /v1, no *chat*, no *completions*.
# Grepping a CI-Hub checkout's packages/backend/src for a `chat/completions` route, or for any
# `v1/…` route declaration, returns nothing — the same answer from a third direction.
#
# A `http://ci-os-hub:3000/api/inference/v1` base does appear in
# CI-Server/docs/architecture/hub-inference-integration.md §2, and it is tempting because it looks
# authoritative — but that document is headed "Status: Design / proposal" and its §7 lists two hard
# prerequisites in CI-Hub that block it today. It is a contract to be built, not one to configure
# against: with no such route registered, a POST to it is a 404 on every turn.
#
# The Hub hands out the BACKEND's address instead, over
# GET /api/inference/apps/<slug>/credentials.env: `${ollamaBaseUrl}/v1`, with ollamaBaseUrl
# resolved among host.docker.internal / 172.17.0.1 / localhost on :11434. The default below is
# that address as seen from this box, which runs network_mode: host. Change it if the Hub's
# Ollama is on another machine, or to any other OpenAI-compatible server.
#
# CI-MetaHuman cannot fetch those credentials for itself yet: the Hub's APP_ENV_KEYS table
# registers `hermes-agent` and `openclaw` and no slug for this app. Adding one is a CI-Hub change;
# until then these three are set by hand.
#
# CI_HUB_TOKEN: Ollama's /v1 validates nothing, so any non-empty literal works against it. A real
# key is only needed if you repoint this at a gateway that checks one.
CI_HUB_URL=http://127.0.0.1:11434/v1
CI_HUB_TOKEN=ollama
CI_HUB_MODEL=llama3.2
# CI_HUB_* and OPENAI_* are the same three settings under two names: Apply() maps CI_HUB_URL,
# CI_HUB_TOKEN and CI_HUB_MODEL onto OpenAIBaseUrl/OpenAIApiKey/OpenAIModel, then applies OPENAI_*
# afterwards, so an OPENAI_* value wins where both are set. docker-compose.yml derives the OPENAI_*
# trio from the CI_HUB_* trio so the two cannot drift apart. Set these only to aim the same
# OpenAI-compatible client at something that is not the hub (LM Studio, vLLM, llama.cpp, Lemonade).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Backend selection ---
# Explicit and AUTHORITATIVE: an unset MHLLM_BACKEND lets an incidental CI_HUB_URL decide the
# backend for you. An unrecognised value is now logged at Warning and ignored rather than silently
# falling through. Values: ollama | openai
#
# `openai` — the OpenAI-shaped client pointed at CI_HUB_URL above — is the default this file
# ships, and it must stay that way: README.md's quickstart says to copy this file and never
# mentions MHLLM_BACKEND, so whatever is written here is what an operator who followed the
# instructions gets, without ever being told there was a choice. (docker-compose.yml additionally
# defaults the key to `openai`, so a missing or blank .env lands in the same place.)
# For the native Ollama protocol instead, add `-f docker-compose.ollama.yml`, which pins the
# backend itself rather than relying on this line.
MHLLM_BACKEND=openai
# Blank on purpose — see the note at the top of this file. docker-compose.ollama.yml defaults them
# to 127.0.0.1:11434 / gemma4:e2b and docker-compose.face.yml to the :11435 beta-1 tunnel /
# qwen3.8:27b, and a value here would override both. Set them only for a direct-Ollama run with no
# override file — and even then the C++ defaults (MetaHumanLLMSettings.h:53,57) are already
# 127.0.0.1:11434 and llama3.2.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Seconds before a chat request is abandoned; 0 keeps the engine default. Without this a backend
# that accepts the connection and then goes quiet leaves the HUD on "thinking..." for the session.
# Generous, because a COLD 27B model load legitimately takes over a minute to first token.
MHLLM_CHAT_TIMEOUT=180

# --- Local voice services (leave blank to keep the Null STT/TTS stubs) ---
# Kokoro TTS and Whisper STT are both served by Lemonade on the same port. NOTE the API lives under
# /api/v1/..., not /v1/... — verified by probe, not assumed.
KOKORO_SERVER_URL=
# Blank on purpose, same reason as OLLAMA_* above: docker-compose.face.yml carries
# "${KOKORO_MODEL:-kokoro-v1}" for its Lemonade endpoint, and a value here wins over that default.
# Blank lands on kokoro-v1 either way — that is also the C++ default (MetaHumanLLMSettings.h:136).
# Set it only for a Kokoro server that names its model something else.
KOKORO_MODEL=
KOKORO_VOICE=af_sky
# Per-phoneme durations from the kokoro-align sidecar. Blank = a precision loss, never a failure:
# lip-sync falls back to rescaling the spelling estimate to the measured clip length.
# With docker-compose.nvidia.yml the sidecar runs on its own bridge network with no published port,
# so it is http://<KOKORO_ALIGN_IP>:13401 (http://10.213.13.2:13401 by default) -- 127.0.0.1 no
# longer reaches it.
KOKORO_ALIGNER_URL=
# That network's subnet and the sidecar's address on it. Change both together if 10.213.13.0/29
# collides with a network on this host.
KOKORO_ALIGN_SUBNET=10.213.13.0/29
KOKORO_ALIGN_IP=10.213.13.2
# Optional shared token the sidecar then requires on /speak (Authorization: Bearer <token>). Blank
# = no check. The UE client does not send one yet, so a token here turns alignment off for the app
# until it does; it is for other callers of the sidecar.
KOKORO_ALIGN_TOKEN=

WHISPER_SERVER_URL=
# whisper.cpp serves /inference; Lemonade serves the OpenAI shape at the path below.
WHISPER_ENDPOINT_PATH=/api/v1/audio/transcriptions
# REQUIRED by the OpenAI shape and ignored by whisper.cpp. Blank omits the field entirely — which
# is what whisper.cpp wants and what makes Lemonade reject every transcription with a 4xx.
WHISPER_MODEL=Whisper-Base

# Alternative TTS, only selected when Kokoro is unset.
PIPER_SERVER_URL=

# --- Conversation shape and memory ---
# Retained user+assistant PAIRS, excluding the system prompt. 0 = unlimited.
# /api/chat has no server-side session, so the whole transcript is re-sent every turn: uncapped,
# each turn costs more than the last until the request overruns the context window, at which point
# the server truncates FROM THE FRONT and the first thing lost is the persona.
MHLLM_MAX_TURNS=24

# 1 remembers the conversation across sessions. OPT-IN, deliberately: this writes everything anyone
# says to this companion to disk in plain text, indefinitely. Do not enable it on a public kiosk
# without deciding that is what you want.
MHLLM_MEMORY=0
# Blank uses Saved/Companion/Conversation.json.
MHLLM_MEMORY_PATH=

# --- Face ---
# Both are opt-OUT (unset = on): a dead stare and an expressionless face are the regressions these
# exist to fix, so a typo fails toward the working behaviour.
MHLLM_GAZE=1
MHLLM_EMOTION=1

# --- Optional persona override ---
# Blank on purpose, and this one bites harder than the OLLAMA_*/KOKORO_MODEL cases above.
# docker-compose.face.yml carries "${MHLLM_SYSTEM_PROMPT:-You are Eliza, …}" and, a few lines
# below it, a SCRIPTED MHLLM_OPENING_LINE that says "I'm Eliza" verbatim. A generic persona here
# wins over that default, so the face stack would speak a scripted Eliza opening and then answer
# as somebody else — the exact "two different characters" failure that file's own comment warns
# about. Confirmed by rendering the four-file merge with `docker compose config` and reading the
# two values side by side.
#
# Blank is not a loss: MetaHumanLLMSettings.h:89-91 already defaults to the same kind of generic
# companion prompt this line used to carry. Set it to override the persona everywhere, knowing it
# overrides the per-stack ones too.
MHLLM_SYSTEM_PROMPT=
