# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Unreal Engine release (matches the ghcr.io image tags) ---
# UE_RELEASE is the builder's dev-<tag> (dev-5.8 is the confirmed floating tag).
UE_RELEASE=5.8
UE_RELEASE_SHORT=5.8

# Signalling server image. Epic publishes this only up to :5.5; override to a source-built
# 5.8 image (from EpicGamesExt/PixelStreamingInfrastructure) if you hit a protocol mismatch.
SIGNALLING_IMAGE=ghcr.io/epicgames/pixel-streaming-signalling-server:5.5

# --- PUBLIC_IP is normally set for you by run.sh (host's public IP). Override to pin it. ---
PUBLIC_IP=

# --- WebRTC TURN credentials (coturn) ---
TURN_USER=ci-agent
TURN_PASSWORD=change-me-turn-password

# --- CI-portal OIDC (the login gate in front of the stream) ---
# Register this deployment as an OIDC client in ci-portal; use its issuer/discovery URL.
CI_PORTAL_ISSUER_URL=https://portal.companionintelligence.com
CI_PORTAL_CLIENT_ID=metahuman-local-llm
CI_PORTAL_CLIENT_SECRET=change-me-oidc-client-secret
# Public callback URL users are redirected back to (this proxy's /oauth2/callback).
CI_PORTAL_REDIRECT_URL=https://agent.example.com/oauth2/callback
# 32-byte base64/hex random string: `openssl rand -base64 32`
OIDC_COOKIE_SECRET=change-me-32-byte-random

# --- CI-hub Ollama (the LLM backend the agent talks to) ---
# OpenAI-compatible base URL up to and including /v1. The agent appends /chat/completions.
CI_HUB_URL=https://hub.companionintelligence.com/v1
CI_HUB_TOKEN=change-me-hub-token
CI_HUB_MODEL=llama3.2

# --- Optional local voice services (leave blank to keep the Null STT/TTS stubs) ---
WHISPER_SERVER_URL=
PIPER_SERVER_URL=

# --- Optional persona override ---
MHLLM_SYSTEM_PROMPT=You are a helpful, friendly companion speaking through a MetaHuman avatar. Keep replies short and conversational.
